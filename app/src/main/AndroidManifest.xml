<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 悬浮窗按键显示：需要系统级悬浮窗权限 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 长时间后台采集输入：引导用户忽略电池优化 -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 采集服务以前台服务形式运行（用于常驻状态栏提示，避免被系统回收） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ 要求为前台服务声明类型；本服务属于"其它特殊用途"（按键悬浮窗） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        Android 9（API 28）及以下导出到公共下载目录需要这个权限。

        ⚠️ `maxSdkVersion="28"` 是**必须**的:Android 10 起写 `Download/` 走
        MediaStore，完全不需要权限。不加这个上限的话，29+ 会把它列进
        "存储"权限组，用户看到一个"已经无用却还在要"的权限。
        代码侧的对应判断见 `ConfigExporters` 的 `exportToDownloadsLegacy`
        与 `ExportFlow.needsStoragePermission`。
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!--
        ⚠️ 这里**不要**写 android:extractNativeLibs。

        手柄的 native helper（libgamepadmonitor.so）需要被 **shell 身份**
        的进程 `exec`，所以系统必须在安装时把它**解包成真实文件**放进
        ApplicationInfo.nativeLibraryDir（内存映射的库在文件系统里不存在）。

        ⚠️ 但那件事**只能在 build script 里配** —— manifest 里写这个属性
        AGP 9 会直接**构建失败**并指名要改用:
        `packagingOptions.jniLibs.useLegacyPackaging = true`
        （见 app/build.gradle.kts，那里有完整说明）。
    -->
    <application
        android:name=".SthKeyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SthKey">

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!--
            「分享配置」用。
            Android 7+ 起不能把 `file://` 交给别的应用（会抛
            `FileUriExposedException`），必须用 FileProvider 生成 `content://`。

            ⚠️ `exported="false"` + `grantUriPermissions="true"` 是标准组合：
            外部应用**不能**主动来读，只有在某次分享里被我们显式授权才能读
            那一个 Uri。也不能设 `android:permission`，否则接收方读不了。

            authority 用 `${applicationId}.files`，与
            `ConfigExporters.authorityOf()` 里算出来的一致。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|screenLayout|screenSize|smallestScreenSize|orientation"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SthKey"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                ============================================================
                外部导入配置包
                ============================================================
                「用本应用打开 .sthkey / .sthgroup」与「把它分享到本应用」。

                ⚠️ 这里**没有** `application/x-sthkey` 这种自定义 MIME，
                因为它永远不会被匹配到 ——
                Android 的 `MimeTypeMap` 只认内建表里的后缀，
                这两种后缀都不在其中，系统解析出来就是下面这些"大路货"之一。

                于是只能把它们**全部**列上，靠导入时的 manifest 校验兜底：
                收下一个不是配置包的文件不会出事，只会明确报错。

                ⚠️ `*/*` 是**故意不加**的（虽然能提高命中率）：
                加了之后用户在任何文件上点"打开方式"都会看到我们这个
                与文件无关的应用，非常烦人。下面这几种已经覆盖了
                文件管理器、聊天软件、网盘的常见行为。
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />

                <!--
                    字体文件的 MIME。⚠️ 各家报的不一样:
                    正规的是 font/ttf / font/otf / font/collection，
                    但大量文件管理器和聊天软件报的是老式的 application/x-font-*，
                    所以几种都列上。真正的类型判断在导入时按**魔数**做，不靠 MIME。
                -->
                <data android:mimeType="font/ttf" />
                <data android:mimeType="font/otf" />
                <data android:mimeType="font/collection" />
                <data android:mimeType="application/x-font-ttf" />
                <data android:mimeType="application/x-font-otf" />
                <data android:mimeType="application/x-font" />
                <data android:mimeType="application/font-sfnt" />
                <data android:mimeType="application/vnd.ms-opentype" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />

                <!--
                    字体文件的 MIME。⚠️ 各家报的不一样:
                    正规的是 font/ttf / font/otf / font/collection，
                    但大量文件管理器和聊天软件报的是老式的 application/x-font-*，
                    所以几种都列上。真正的类型判断在导入时按**魔数**做，不靠 MIME。
                -->
                <data android:mimeType="font/ttf" />
                <data android:mimeType="font/otf" />
                <data android:mimeType="font/collection" />
                <data android:mimeType="application/x-font-ttf" />
                <data android:mimeType="application/x-font-otf" />
                <data android:mimeType="application/x-font" />
                <data android:mimeType="application/font-sfnt" />
                <data android:mimeType="application/vnd.ms-opentype" />
            </intent-filter>

            <!--
                ============================================================
                一次分享多个文件。我们只取第一个（见 `IncomingConfig`），
                但不声明的话系统在某些应用的分享面板里会**不显示我们**。
                ============================================================
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />

                <!--
                    字体文件的 MIME。⚠️ 各家报的不一样:
                    正规的是 font/ttf / font/otf / font/collection，
                    但大量文件管理器和聊天软件报的是老式的 application/x-font-*，
                    所以几种都列上。真正的类型判断在导入时按**魔数**做，不靠 MIME。
                -->
                <data android:mimeType="font/ttf" />
                <data android:mimeType="font/otf" />
                <data android:mimeType="font/collection" />
                <data android:mimeType="application/x-font-ttf" />
                <data android:mimeType="application/x-font-otf" />
                <data android:mimeType="application/x-font" />
                <data android:mimeType="application/font-sfnt" />
                <data android:mimeType="application/vnd.ms-opentype" />
            </intent-filter>

        </activity>

        <!--
            ============================================================
            「纯无障碍」采集通道
            ============================================================
            无障碍服务由**系统**绑定并启动，所以:
            ⚠️ `exported` 必须是 true:系统要能跨进程绑定它。设成 false 的话
            服务永远不会被拉起，而且**不会报错**。

            ⚠️ `android:permission` 必须是 BIND_ACCESSIBILITY_SERVICE:
            少了这条，任何应用都能连上我们的服务并窥探按键。

            ⚠️ `<intent-filter>` 里那个 action 不能少:系统就是按它找
            "哪些是无障碍服务"，漏了它「无障碍」列表里根本没有本应用。

            ⚠️ `meta-data` 指向 `accessibility_service_config`:
            能不能读按键、要不要窗口内容，全在那份 XML 里声明。

        -->
        <service
            android:name=".capture.accessibility.SthKeyAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
            悬浮窗服务：在 WindowManager 上叠加按键显示。
            前台服务 + specialUse 类型：悬浮窗需要长时间存活，
            普通后台服务在 Android 12+ 很容易被冻结回收（窗口会直接消失）。
        -->
        <service
            android:name=".capture.OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="按键悬浮窗：在其他应用之上显示外接键盘的按键状态" />
        </service>

        <!--
            触屏「区域编辑」的全屏编辑器（`TouchRegionEditorService.start` 里
            用 `startForegroundService` 拉起，所以必须声明类型）。
        -->
        <service
            android:name=".capture.touch.TouchRegionEditorService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="触屏区域编辑：在编辑页显示可拖动的触摸区域方块" />
        </service>
    </application>

</manifest>
